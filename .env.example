# RuleBox 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# 查看 Token（用于访问 YAML 配置）
# 提示：使用以下命令生成强随机 token：
#   openssl rand -base64 32
#   或使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIEW_TOKEN=your_strong_random_token_here

# 管理 Token（用于所有写操作）
# 建议使用与 VIEW_TOKEN 不同的强随机值
ADMIN_TOKEN=your_strong_random_token_here

# 服务端口（默认 8080）
PORT=8080

# 数据存储目录（默认 ./data）
DATA_DIR=./data

# 是否启用 Swagger API 文档（默认关闭，开发时可设为 true）
ENABLE_SWAGGER=false